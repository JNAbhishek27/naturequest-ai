# NatureQuest AI Environment Configuration
# Copy this file to .env and insert your real credentials.
# NEVER commit your actual .env file or API keys!

# Port for local development / hosting
PORT=5000

# -------------------------------------------------------------
# Google GenAI API (Recommended for Gemma via Google Gen AI SDK)
# -------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# Gemma model identifier supported on Google Gen AI API
# Supported models include:
# - gemma-3-1b-it
# - gemma-3-4b-it
# - gemma-3-12b-it
# - gemma-3-27b-it
# - gemma-2-9b-it
# - gemma-2-27b-it
GEMMA_MODEL_ID=gemma-3-4b-it

# -------------------------------------------------------------
# Optional Alternative: Hugging Face Inference API / Endpoints
# -------------------------------------------------------------
# HUGGINGFACE_API_TOKEN=
# GEMMA_HF_MODEL_ID=google/gemma-2-2b-it
